# اختر مزود الذكاء الاصطناعي: "google" أو "openai"
AI_PROVIDER=google

# مفتاح Google Gemini API (عند استخدام @google/genai)
# احصل عليه من: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# مفتاح OpenAI API (عند استخدام openai)
# احصل عليه من: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# نموذج الذكاء الاصطناعي المستخدم
# لـ Google: gemini-flash-latest, gemini-flash-lite-latest, gemini-2.5-flash
# لـ OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
AI_MODEL=gemini-flash-lite-latest
# AI_MODEL=gpt-4o-mini

# ── إعدادات سيرفر واتساب Webhook ──
PORT=3000
WEBHOOK_VERIFY_TOKEN=my_secret_token
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id

# ── الدفع عبر Stripe (اختياري — بدونه يعمل رابط محلي تجريبي) ──
# احصل عليه من: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
PUBLIC_BASE_URL=https://kareem-whatsapp-agent.onrender.com
